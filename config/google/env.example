# Скопируйте в config/google/.env и заполните значения.
# Service Account JSON: скачайте в Google Cloud Console → IAM → Service Accounts → Keys.

SERVICE_ACCOUNT_PATH=I:\Concept-document\config\google\service-account.json
DRIVE_FOLDER_ID=ваш_id_папки_из_url_drive

# URL папки: https://drive.google.com/drive/folders/ЭТОТ_ID
# Папку нужно расшарить на client_email из service-account.json (роль: Редактор)
